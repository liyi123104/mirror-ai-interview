# 复制成 .env 再填真实值（.env 已经在 .gitignore 里，不会进 Git）
DEEPSEEK_API_KEY=sk-替换成你的
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_MAIN=deepseek-chat

# Windows 用 host.docker.internal；Linux 服务器上没有 Ollama 就留空
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Java 与 Python 之间的内部令牌，换成一段随机字符串
INTERNAL_TOKEN=dev-token-change-me
