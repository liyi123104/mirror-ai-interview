# 复制成 .env 再填真实值（.env 在 .gitignore 里，不会进 Git）
# start.bat / start-all.ps1 会自动读取这个文件并注入环境变量

DEEPSEEK_API_KEY=sk-替换成你的
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_MAIN=deepseek-chat

# Windows 用 host.docker.internal；Linux 服务器上没有 Ollama 就留空
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ---------------------------------------------------------------------------
# 下面三个是「交付前必须换掉」的默认值
# ---------------------------------------------------------------------------

# Java 与 Python 之间的内部令牌（两边必须一致）
# 生成：openssl rand -hex 16  或  powershell -Command "[guid]::NewGuid().ToString('N')"
INTERNAL_TOKEN=dev-token-change-me

# 登录 JWT 签名密钥，至少 32 位随机串；换掉之后所有人需要重新登录
MIRROR_JWT_SECRET=mirror-dev-secret-please-change-in-production

# 数据库密码（本机默认 mirror123）
MIRROR_DB_PASSWORD=mirror123

# 可选：生产环境把接口文档关掉（默认 true）
# MIRROR_SWAGGER_ENABLED=false
